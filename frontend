@Composable
fun AnimatedParticles() {
    val infiniteTransition = rememberInfiniteTransition(label = "particles")
    val particles = remember { List(15) { Pair(Random.nextFloat(), Random.nextFloat()) } }

    val animatedOffset by infiniteTransition.animateFloat(
        initialValue = 0f,
        targetValue = 1f,
        animationSpec = infiniteRepeatable(
            animation = tween(20000, easing = LinearEasing),
            repeatMode = RepeatMode.Restart
        ),
        label = "particle_offset"
    )

    Canvas(modifier = Modifier.fillMaxSize()) {
        particles.forEach { (x, y) ->
            val offsetY = (animatedOffset * size.height + y * 100) % size.height
            drawCircle(
                color = Color(0xFF00D9FF).copy(alpha = 0.3f),
                radius = 2f,
                center = Offset(x * size.width, offsetY)
            )
        }
    }
}

