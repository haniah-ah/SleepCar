@Composable
fun ChartCard(data: List<Float>) {
    Card(
        modifier = Modifier
            .fillMaxWidth()
            .height(200.dp),
        shape = RoundedCornerShape(20.dp),
        colors = CardDefaults.cardColors(
            containerColor = Color(0xFF151B3D).copy(alpha = 0.6f)
        )
    ) {
        Column(modifier = Modifier.padding(20.dp)) {
            Text(
                text = "EYE ASPECT RATIO TREND",
                fontSize = 14.sp,
                fontWeight = FontWeight.Bold,
                color = Color.White,
                letterSpacing = 1.sp
            )
            Spacer(modifier = Modifier.height(16.dp))

            Canvas(modifier = Modifier.fillMaxSize()) {
                if (data.size > 1) {
                    val path = Path()
                    val stepX = size.width / (data.size - 1)

                    data.forEachIndexed { index, value ->
                        val x = index * stepX
                        val normalizedValue = (value - 0.15f) / 0.2f
                        val y = size.height - (normalizedValue * size.height).coerceIn(0f, size.height)

                        if (index == 0) {
                            path.moveTo(x, y)
                        } else {
                            path.lineTo(x, y)
                        }
                    }

                    drawPath(
                        path = path,
                        color = Color(0xFF00D9FF),
                        style = Stroke(width = 3f, cap = StrokeCap.Round)
                    )
                }
            }
        }
    }
}

