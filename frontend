@Composable
fun AnimatedToggleButton(isActive: Boolean, onClick: () -> Unit) {
    val scale by animateFloatAsState(
        targetValue = if (isActive) 1.05f else 1f,
        animationSpec = spring(dampingRatio = Spring.DampingRatioMediumBouncy),
        label = "button_scale"
    )

    Box(
        modifier = Modifier
            .scale(scale)
            .size(70.dp)
            .clip(CircleShape)
            .background(
                if (isActive)
                    Brush.radialGradient(listOf(Color(0xFF39FF14), Color(0xFF00AA00)))
                else
                    Brush.radialGradient(listOf(Color(0xFF666666), Color(0xFF333333)))
            )
            .clickable(onClick = onClick),
        contentAlignment = Alignment.Center
    ) {
        // Custom drawn play/stop icon
        Canvas(modifier = Modifier.size(32.dp)) {
            if (isActive) {
                drawRect(
                    color = Color.White,
                    topLeft = Offset(size.width * 0.25f, size.height * 0.25f),
                    size = androidx.compose.ui.geometry.Size(size.width * 0.5f, size.height * 0.5f)
                )
            } else {
                val path = Path().apply {
                    moveTo(size.width * 0.3f, size.height * 0.2f)
                    lineTo(size.width * 0.3f, size.height * 0.8f)
                    lineTo(size.width * 0.75f, size.height * 0.5f)
                    close()
                }
                drawPath(path = path, color = Color.White)
            }
        }
    }
}

@Composable
fun CircularGauge(
    value: Float,
    label: String,
    alertLevel: String,
    maxValue: Float = 100f
) {
    val animatedValue by animateFloatAsState(
        targetValue = value,
        animationSpec = spring(dampingRatio = Spring.DampingRatioLowBouncy),
        label = "gauge_value"
    )

    val gaugeColor = when (alertLevel) {
        "critical" -> Color(0xFFFF3366)
        "warning" -> Color(0xFFFFAA00)
        else -> Color(0xFF00D9FF)
    }

    Card(
        modifier = Modifier.fillMaxWidth(),
        shape = RoundedCornerShape(24.dp),
        colors = CardDefaults.cardColors(
            containerColor = Color(0xFF151B3D).copy(alpha = 0.6f)
        )
    ) {
        Box(
            modifier = Modifier
                .fillMaxWidth()
                .padding(24.dp),
            contentAlignment = Alignment.Center
        ) {
            Canvas(modifier = Modifier.size(150.dp)) {
                drawArc(
                    color = Color(0xFF2A3456),
                    startAngle = 135f,
                    sweepAngle = 270f,
                    useCenter = false,
                    style = Stroke(width = 20f, cap = StrokeCap.Round)
                )

                drawArc(
                    brush = Brush.sweepGradient(
                        colors = listOf(gaugeColor, gaugeColor.copy(alpha = 0.5f), gaugeColor)
                    ),
                    startAngle = 135f,
                    sweepAngle = (animatedValue / maxValue) * 270f,
                    useCenter = false,
                    style = Stroke(width = 20f, cap = StrokeCap.Round)
                )
            }

            Column(horizontalAlignment = Alignment.CenterHorizontally) {
                Text(
                    text = "${animatedValue.toInt()}",
                    fontSize = 40.sp,
                    fontWeight = FontWeight.Bold,
                    color = gaugeColor
                )
                Text(
                    text = label,
                    fontSize = 12.sp,
                    color = Color.Gray,
                    modifier = Modifier.padding(top = 4.dp)
                )
            }
        }
    }
}

