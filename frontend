@Composable
fun CameraFeedView(isActive: Boolean, eyeAspectRatio: Float) {
    val detectionColor = if (eyeAspectRatio < 0.23f) Color(0xFFFF3366) else Color(0xFF39FF14)
    val borderColor = if (isActive) detectionColor else Color(0xFF00D9FF).copy(alpha = 0.4f)
    val animatedBorderColor by animateColorAsState(
        targetValue = borderColor,
        animationSpec = spring(dampingRatio = Spring.DampingRatioMediumBouncy),
        label = "camera_border_color"
    )

    Card(
        modifier = Modifier
            .fillMaxWidth()
            .height(300.dp) // Taller view for better camera space
            .border(
                width = 2.dp,
                brush = Brush.verticalGradient(
                    listOf(animatedBorderColor, Color.Transparent)
                ),
                shape = RoundedCornerShape(20.dp)
            )
            .padding(2.dp),
        shape = RoundedCornerShape(20.dp),
        colors = CardDefaults.cardColors(
            containerColor = Color.Black.copy(alpha = 0.5f)
        ),
        elevation = CardDefaults.cardElevation(8.dp)
    ) {
        Box(modifier = Modifier.fillMaxSize()) {
            if (isActive) {
                // *** REAL-TIME CAMERA VIEW ***
                CameraPreviewComposable(
                    modifier = Modifier.fillMaxSize(),
                    detectionBoxColor = detectionColor
                )
            } else {
                // IDLE Placeholder
                Box(
                    modifier = Modifier.fillMaxSize(),
                    contentAlignment = Alignment.Center
                ) {
                    Text(
                        text = "Awaiting Activation...",
                        fontSize = 18.sp,
                        color = Color.Gray
                    )
                }
            }

            // Live Status Overlay
            Column(
                modifier = Modifier
                    .fillMaxWidth()
                    .align(Alignment.BottomCenter)
                    .padding(16.dp),
                horizontalAlignment = Alignment.CenterHorizontally
            ) {
                Text(
                    text = "LIVE CAMERA FEED",
                    fontSize = 16.sp,
                    fontWeight = FontWeight.Light,
                    color = animatedBorderColor
                )
                val statusText = when {
                    !isActive -> "System Idle"
                    eyeAspectRatio < 0.23f -> "Eyes Closing - Alert Imminent!"
                    else -> "Face Detected - Monitoring Active"
                }
                Text(
                    text = statusText,
                    fontSize = 14.sp,
                    color = if (isActive) detectionColor else Color.Gray,
                    fontWeight = FontWeight.SemiBold
                )
            }
        }
    }
}

// --- CAMERA X INTEGRATION (NEW) ---
@Composable
fun CameraPreviewComposable(
    modifier: Modifier = Modifier,
    detectionBoxColor: Color
) {
    val lifecycleOwner = LocalLifecycleOwner.current
    val context = LocalContext.current
    val cameraProviderFuture = remember { ProcessCameraProvider.getInstance(context) }

    AndroidView(
        modifier = modifier.clip(RoundedCornerShape(20.dp)),
        factory = { ctx ->
            PreviewView(ctx).apply {
                layoutParams = ViewGroup.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT,
                    ViewGroup.LayoutParams.MATCH_PARENT
                )
                // Use FILL_START to fit the front-facing camera correctly
                implementationMode = PreviewView.ImplementationMode.COMPATIBLE
                scaleType = PreviewView.ScaleType.FILL_START
            }
        },
        update = { previewView ->
            val cameraProvider = cameraProviderFuture.get()
            cameraProvider.unbindAll()

            val preview = Preview.Builder().build().also {
                it.setSurfaceProvider(previewView.surfaceProvider)
            }

            val cameraSelector = CameraSelector.Builder()
                .requireLensFacing(CameraSelector.LENS_FACING_FRONT)
                .build()

            try {
                // Bind use cases to camera
                cameraProvider.bindToLifecycle(
                    lifecycleOwner,
                    cameraSelector,
                    preview
                    // Add ImageAnalysis use case here for ML Kit in final project
                )
            } catch (exc: Exception) {
                // Handle binding failures
            }
        }
    )

    // Simple visual feedback for "green square" promise
    Canvas(modifier = modifier) {
        // Draw the "Face Detected" box
        drawRect(
            color = detectionBoxColor,
            topLeft = Offset(size.width * 0.3f, size.height * 0.2f),
            size = androidx.compose.ui.geometry.Size(size.width * 0.4f, size.height * 0.6f),
            style = Stroke(width = 4f),
            alpha = 0.8f // Keep it slightly transparent
        )
    }
}


