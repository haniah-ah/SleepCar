// --- PERMISSION HANDLING (NEW) ---
@OptIn(ExperimentalPermissionsApi::class)
@Composable
fun CameraPermissionRequester(content: @Composable () -> Unit) {
    val cameraPermissionState = rememberPermissionState(Manifest.permission.CAMERA)

    if (cameraPermissionState.status.isGranted) {
        content()
    } else {
        Column(
            modifier = Modifier
                .fillMaxSize()
                .background(Color(0xFF0A0E27)),
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.Center
        ) {
            Text("Camera permission is required to detect drowsiness.", color = Color.White)
            Spacer(Modifier.height(16.dp))
            Button(onClick = { cameraPermissionState.launchPermissionRequest() }) {
                Text("Grant Camera Permission")
            }
        }
    }
}

// --- THE MAIN DASHBOARD ---
@Composable
fun DrowsinessDetectionDashboard() {
    val context = LocalContext.current
    val coroutineScope = rememberCoroutineScope()
    val dataStore = remember { SettingsDataStore(context) }

    // State Variables
    var isActive by remember { mutableStateOf(false) }
    var drowsinessScore by remember { mutableStateOf(0f) }
    var eyeAspectRatio by remember { mutableStateOf(0.3f) }
    var blinkCount by remember { mutableStateOf(0) }
    var yawnCount by remember { mutableStateOf(0) }
    var alertLevel by remember { mutableStateOf("safe") }
    var showAlert by remember { mutableStateOf(false) }

    // Persistent Settings (Read from DataStore)
    val sensitivityFlow = dataStore.sensitivityFlow.collectAsState(initial = 70f)
    val alertVolumeFlow = dataStore.alertVolumeFlow.collectAsState(initial = 80f)

    val sensitivity by sensitivityFlow
    val alertVolume by alertVolumeFlow
    var alertSound by remember { mutableStateOf("Standard Siren") }

    val historyData = remember { mutableStateListOf<Float>() }

    // Alarm Player Setup
    val mediaPlayer by remember { mutableStateOf(MediaPlayer()) }

    // Load settings from DataStore on startup (flows handle this implicitly)
    // Save settings when state changes
    val onSensitivityChange: (Float) -> Unit = { newValue ->
        coroutineScope.launch {
            dataStore.saveSensitivity(newValue)
        }
    }
    val onAlertVolumeChange: (Float) -> Unit = { newValue ->
        coroutineScope.launch {
            dataStore.saveAlertVolume(newValue)
            // Optional: immediately adjust the media player volume if playing
            val volume = newValue / 100f
            mediaPlayer.setVolume(volume, volume)
        }
    }

    // --- REAL-TIME DATA SIMULATION AND ALARM LOGIC ---
    LaunchedEffect(isActive) {
        if (isActive) {
            while (true) {
                delay(500)

                // --- Data Simulation ---
                eyeAspectRatio = (eyeAspectRatio + (Random.nextFloat() - 0.48f) * 0.03f)
                    .coerceIn(0.15f, 0.35f)

                val earPenalty = if (eyeAspectRatio < 0.2f) 30f else 0f
                drowsinessScore = (drowsinessScore + (Random.nextFloat() - 0.45f) * 10f + earPenalty)
                    .coerceIn(0f, 100f)

                if (Random.nextFloat() > 0.85f) blinkCount++
                if (Random.nextFloat() > 0.97f) yawnCount++

                // --- Alert Logic (Uses Sensitivity from DataStore) ---
                val criticalThreshold = 95f - (sensitivity * 0.25f)
                val warningThreshold = 70f - (sensitivity * 0.15f)

                alertLevel = when {
                    drowsinessScore > criticalThreshold -> "critical"
                    drowsinessScore > warningThreshold -> "warning"
                    else -> "safe"
                }

                if (alertLevel == "critical" && !showAlert) {
                    showAlert = true
                }

                // Update history
                historyData.add(eyeAspectRatio)
                if (historyData.size > 20) historyData.removeAt(0)
            }
        }
    }

    // --- ALARM SOUND EFFECT (NEW) ---
    LaunchedEffect(showAlert) {
        if (showAlert) {
            try {
                mediaPlayer.reset()

                // Use the URI for the raw resource
                //val uri = Uri.parse("android.resource://${context.packageName}/${ALERT_SOUND_RES_ID}")
                //mediaPlayer.setDataSource(context, uri)

                // Set audio attributes for alarm sound
                mediaPlayer.setAudioAttributes(
                    AudioAttributes.Builder()
                        .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)
                        .setUsage(AudioAttributes.USAGE_ALARM)
                        .build()
                )

                // Set volume from DataStore setting
                val volume = alertVolume / 100f
                mediaPlayer.setVolume(volume, volume)

                mediaPlayer.isLooping = true // Alarm loops until dismissed
                mediaPlayer.prepare()
                mediaPlayer.start()
            } catch (e: Exception) {
                e.printStackTrace()
            }
        } else {
            // Stop and release when dismissed
            if (mediaPlayer.isPlaying) {
                mediaPlayer.stop()
            }
        }
    }

    // --- UI LAYOUT ---
    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(
                Brush.verticalGradient(
                    colors = listOf(
                        Color(0xFF0A0E27),
                        Color(0xFF1A1F3A),
                        Color(0xFF0A0E27)
                    )
                )
            )
    ) {
        AnimatedParticles()

        Column(
            modifier = Modifier
                .fillMaxSize()
                .verticalScroll(rememberScrollState())
                .padding(20.dp)
        ) {
            // Header
            HeaderSection(
                isActive = isActive,
                onToggle = {
                    isActive = !isActive
                    // Reset session on START
                    if (isActive) {
                        drowsinessScore = 0f
                        blinkCount = 0
                        yawnCount = 0
                        historyData.clear()
                    }
                }
            )

            Spacer(modifier = Modifier.height(24.dp))

            // Camera Feed View
            CameraFeedView(
                isActive = isActive,
                eyeAspectRatio = eyeAspectRatio
            )

            Spacer(modifier = Modifier.height(24.dp))

            // Main metrics row (Gauges)
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.spacedBy(16.dp)
            ) {
                Box(modifier = Modifier.weight(1f)) {
                    CircularGauge(drowsinessScore, "Drowsiness Score", alertLevel)
                }
                Box(modifier = Modifier.weight(1f)) {
                    CircularGauge(
                        value = eyeAspectRatio * 300,
                        label = "Eye Aspect Ratio",
                        alertLevel = if (eyeAspectRatio < 0.2f) "warning" else "safe",
                        maxValue = 100f
                    )
                }
            }

            Spacer(modifier = Modifier.height(24.dp))

            // Stats cards
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.spacedBy(12.dp)
            ) {
                StatCard("Blinks", blinkCount.toString(), Modifier.weight(1f))
                StatCard("Yawns", yawnCount.toString(), Modifier.weight(1f))
                StatCard(
                    title = "Status",
                    value = alertLevel.uppercase(),
                    modifier = Modifier.weight(1f),
                    statusColor = when(alertLevel) {
                        "critical" -> Color(0xFFFF3366)
                        "warning" -> Color(0xFFFFAA00)
                        else -> Color(0xFF39FF14)
                    }
                )
            }

            Spacer(modifier = Modifier.height(24.dp))

            // EAR History Chart
            ChartCard(historyData)

            Spacer(modifier = Modifier.height(24.dp))

            // Enhanced Settings Control
            SettingsPanel(
                sensitivity = sensitivity,
                alertVolume = alertVolume,
                alertSound = alertSound,
                onSensitivityChange = onSensitivityChange,
                onAlertVolumeChange = onAlertVolumeChange,
                onAlertSoundChange = { alertSound = it } // Sound selection is a simple string for demo
            )

            Spacer(modifier = Modifier.height(40.dp))
        }

        // Critical Alert Modal
        if (showAlert) {
            CriticalAlertModal(
                onDismiss = {
                    showAlert = false
                    drowsinessScore = 0f // Reset score after acknowledging
                    blinkCount = 0 // Reset session stats
                    yawnCount = 0
                    historyData.clear()
                }
            )
        }
    }
}

