<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Drowsiness Detection</title>
<!-- Google Fonts & Chart.js -->
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
    body {
        margin: 0;
        font-family: 'Roboto', sans-serif;
        background: linear-gradient(135deg, #0A0E27, #1A1F3A);
        color: white;
    }

    header {
        text-align: center;
        padding: 30px 0;
        font-weight: bold;
        letter-spacing: 2px;
        color: #00D9FF;
    }

    #cameraContainer {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
        position: relative;
    }

    video {
        border-radius: 20px;
        border: 5px solid #39FF14;
        width: 400px;
        height: 300px;
        object-fit: cover;
        box-shadow: 0 0 20px rgba(0, 217, 255, 0.7);
    }

    #stats {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: rgba(21, 27, 61, 0.7);
        border-radius: 20px;
        padding: 20px;
        text-align: center;
        width: 120px;
        box-shadow: 0 0 15px rgba(255,255,255,0.2);
        transition: transform 0.3s;
    }

    .stat-card:hover {
        transform: scale(1.05);
    }

    .stat-value {
        font-size: 32px;
        font-weight: bold;
        margin-top: 10px;
        color: #00D9FF;
    }

    #controls {
        display: flex;
        justify-content: center;
        gap: 40px;
        margin-bottom: 40px;
    }

    .control-slider {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    input[type="range"] {
        -webkit-appearance: none;
        width: 150px;
        height: 6px;
        border-radius: 5px;
        background: #2A3456;
        outline: none;
    }

    input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: #00D9FF;
        cursor: pointer;
    }

    button {
        background: #39FF14;
        border: none;
        padding: 12px 25px;
        border-radius: 12px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
        font-size: 16px;
    }

    button:hover {
        background: #00AA00;
    }

    #chartContainer {
        width: 80%;
        margin: 0 auto 50px auto;
    }

    /* Alert Modal */
    #alertModal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.85);
        justify-content: center;
        align-items: center;
        z-index: 10;
    }

    #alertContent {
        background: #1A1F3A;
        padding: 40px;
        border-radius: 24px;
        text-align: center;
        border: 3px solid #FF3366;
        box-shadow: 0 0 30px #FF3366;
    }

    #alertContent h2 {
        color: #FF3366;
        font-size: 28px;
        margin-bottom: 20px;
    }

    #alertContent p {
        margin-bottom: 25px;
        font-size: 16px;
        color: white;
    }

    #alertContent button {
        background: #FF3366;
    }
</style>
</head>
<body>

<header>DROWSINESS DETECTION DASHBOARD</header>

<div id="cameraContainer">
    <video id="cameraFeed" autoplay></video>
</div>

<div id="stats">
    <div class="stat-card">
        <div>Blinks</div>
        <div class="stat-value" id="blinkCount">0</div>
    </div>
    <div class="stat-card">
        <div>Yawns</div>
        <div class="stat-value" id="yawnCount">0</div>
    </div>
    <div class="stat-card">
        <div>Drowsiness</div>
        <div class="stat-value" id="drowsinessScore">0</div>
    </div>
</div>

<div id="controls">
    <div class="control-slider">
        <label for="sensitivity">Sensitivity</label>
        <input type="range" id="sensitivity" min="0" max="100" value="70">
    </div>
    <div class="control-slider">
        <label for="volume">Alert Volume</label>
        <input type="range" id="volume" min="0" max="100" value="80">
    </div>
</div>

<div style="text-align:center; margin-bottom: 30px;">
    <button id="startBtn">Start Monitoring</button>
</div>

<div id="chartContainer">
    <canvas id="earChart"></canvas>
</div>

<!-- Critical Alert Modal -->
<div id="alertModal">
    <div id="alertContent">
        <h2>CRITICAL DROWSINESS!</h2>
        <p>Pull over and rest immediately!</p>
        <button id="dismissAlert">I'M AWAKE</button>
    </div>
</div>

<script>
const video = document.getElementById('cameraFeed');
const startBtn = document.getElementById('startBtn');
const blinkCountEl = document.getElementById('blinkCount');
const yawnCountEl = document.getElementById('yawnCount');
const drowsinessScoreEl = document.getElementById('drowsinessScore');
const alertModal = document.getElementById('alertModal');
const dismissAlert = document.getElementById('dismissAlert'); 
const earChartCtx = document.getElementById('earChart').getContext('2d');

let drowsinessScore = 0;
let historyData = [];
let monitoring = false;
let drowsyFramesCount = 0;
const DROWSY_ALERT_THRESHOLD = 10; // Show alert after 10 consecutive drowsy frames

const earChart = new Chart(earChartCtx, {
    type: 'line',
    data: {
        labels: [],
        datasets: [{
            label: 'Drowsiness Score',
            data: [],
            borderColor: '#00D9FF',
            borderWidth: 3,
            fill: false,
            tension: 0.3
        }]
    },
    options: {
        responsive: true,
        animation: { duration: 0 },
        scales: {
            x: { display: false },
            y: { min: 0, max: 100 }
        }
    }
});

async function processFrame() {
    if (video.paused || video.ended || !monitoring) {
        return;
    }

    // Capture a frame to a canvas
    const canvas = document.createElement('canvas');
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    canvas.getContext('2d').drawImage(video, 0, 0);
    const imageDataURL = canvas.toDataURL('image/jpeg');

    try {
        const response = await fetch('http://127.0.0.1:5000/detect', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ image: imageDataURL })
        });

        if (!response.ok) {
            console.error("Server error:", response.statusText);
            return;
        }

        const data = await response.json();

        // Update UI with data from Python backend
        blinkCountEl.textContent = data.closed_eyes_duration.toFixed(1) + 's';
        yawnCountEl.textContent = data.yawn_duration.toFixed(1) + 's';

        // A simple score based on the server's drowsy state
        drowsinessScore = data.drowsy_state ? Math.min(100, drowsinessScore + 10) : Math.max(0, drowsinessScore - 5);
        drowsinessScoreEl.textContent = Math.round(drowsinessScore);

        // Update chart
        historyData.push(drowsinessScore);
        if (historyData.length > 30) historyData.shift();
        earChart.data.labels = historyData.map((_, i) => i);
        earChart.data.datasets[0].data = historyData;
        earChart.update();

        // --- Alerting ---
        if (data.drowsy_state) {
            drowsyFramesCount++;
        } else {
            drowsyFramesCount = 0;
        }

        if (drowsyFramesCount > DROWSY_ALERT_THRESHOLD) {
            alertModal.style.display = 'flex';
        }

    } catch (error) {
        console.error("Error sending frame to server:", error);
    }
}


startBtn.onclick = async () => {
    if (monitoring) return;
    monitoring = true;
    startBtn.textContent = "MONITORING...";
    startBtn.style.background = "#FF8C00";

    try {
        const stream = await navigator.mediaDevices.getUserMedia({ video: true });
        video.srcObject = stream;
        video.onloadedmetadata = () => {
            video.play();
            // Start processing frames every 200ms (5 FPS)
            setInterval(processFrame, 200);
        };
    } catch (err) {
        console.error("Error accessing webcam:", err);
        alert("Could not access the webcam. Please check permissions.");
        monitoring = false;
        startBtn.textContent = "Start Monitoring";
        startBtn.style.background = "#39FF14";
    }
};

dismissAlert.onclick = () => {
    alertModal.style.display = 'none';
    // Reset scores to give the driver a chance to recover
    drowsinessScore = 0;
    drowsyFramesCount = 0;
};
</script>

</body>
</html>
