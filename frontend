@Composable
fun CriticalAlertModal(onDismiss: () -> Unit) {
    val infiniteTransition = rememberInfiniteTransition(label = "alert")
    val pulseAlpha by infiniteTransition.animateFloat(
        initialValue = 0.5f,
        targetValue = 1f,
        animationSpec = infiniteRepeatable(
            animation = tween(800),
            repeatMode = RepeatMode.Reverse
        ),
        label = "pulse"
    )

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(Color.Black.copy(alpha = 0.8f))
            .clickable(onClick = onDismiss),
        contentAlignment = Alignment.Center
    ) {
        Card(
            modifier = Modifier
                .fillMaxWidth(0.85f)
                .wrapContentHeight(),
            shape = RoundedCornerShape(24.dp),
            colors = CardDefaults.cardColors(
                containerColor = Color(0xFF1A1F3A)
            ),
            elevation = CardDefaults.cardElevation(16.dp)
        ) {
            Column(
                modifier = Modifier.padding(32.dp),
                horizontalAlignment = Alignment.CenterHorizontally
            ) {
                // Warning Icon
                Canvas(modifier = Modifier.size(80.dp)) {
                    val path = Path().apply {
                        moveTo(size.width * 0.5f, size.height * 0.1f)
                        lineTo(size.width * 0.9f, size.height * 0.9f)
                        lineTo(size.width * 0.1f, size.height * 0.9f)
                        close()
                    }
                    drawPath(
                        path = path,
                        color = Color(0xFFFF3366).copy(alpha = pulseAlpha),
                        style = Stroke(width = 8f)
                    )
                    drawCircle(
                        color = Color(0xFFFF3366).copy(alpha = pulseAlpha),
                        radius = 4f,
                        center = Offset(size.width * 0.5f, size.height * 0.75f)
                    )
                    drawRect(
                        color = Color(0xFFFF3366).copy(alpha = pulseAlpha),
                        topLeft = Offset(size.width * 0.48f, size.height * 0.4f),
                        size = androidx.compose.ui.geometry.Size(size.width * 0.04f, size.height * 0.25f)
                    )
                }

                Spacer(modifier = Modifier.height(20.dp))
                Text(
                    text = "CRITICAL DROWSINESS",
                    fontSize = 24.sp,
                    fontWeight = FontWeight.Bold,
                    color = Color(0xFFFF3366)
                )
                Spacer(modifier = Modifier.height(12.dp))
                Text(
                    text = "Pull off the road and rest immediately!",
                    fontSize = 16.sp,
                    color = Color.White,
                    textAlign = TextAlign.Center
                )
                Spacer(modifier = Modifier.height(24.dp))
                Button(
                    onClick = onDismiss,
                    modifier = Modifier.fillMaxWidth(),
                    shape = RoundedCornerShape(12.dp),
                    colors = ButtonDefaults.buttonColors(
                        containerColor = Color(0xFFFF3366)
                    )
                ) {
                    Text(
                        text = "I'M AWAKE (TAP TO DISMISS)",
                        modifier = Modifier.padding(8.dp),
                        fontSize = 16.sp,
                        fontWeight = FontWeight.Bold
                    )
                }
            }
        }
    }
}
